#!name = 36氪去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 53 行，[0~9] 段；追加 kelee:36Kr_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/gateway\.36kr\.com\/api\/adx\/ad\/show url reject-200

# ↓ 来自 kelee:36Kr_remove_ads.lpx「36氪去广告」
host, adx.36kr.com, reject
^https:\/\/gateway\.36kr\.com\/api\/mis\/nav\/home\/subnav\/flow\/ url jsonjq-response-body 'del(.["data"]["adItemList"])'
^https:\/\/gateway\.36kr\.com\/api\/adx\/ url reject-dict

hostname = gateway.36kr.com
