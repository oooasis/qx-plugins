#!name = 5EPlay
#!desc = 移除开屏广告、弹窗广告、活动角标、商城。（转自可莉 5EPlay_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png

^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\? url jsonjq-response-body 'del(.["data"]["function_configs"]["startup_ad_switch"], .["data"]["function_configs"]["startup_ad_timeout"], .["data"]["function_configs"]["startup_ad_day_max"], .["data"]["function_configs"]["app_bar_guide_width"], .["data"]["function_configs"]["app_bar_guide_height"], .["data"]["function_configs"]["app_bar_guide_url"], .["data"]["function_configs"]["app_bar_guide_time"], .["data"]["function_configs"]["home_tab_event_tag"], .["data"]["function_configs"]["home_tab_event_tag_ext"], .["data"]["function_configs"]["home_tab_player_tag"], .["data"]["function_configs"]["home_tab_player_tag_ext"], .["data"]["function_configs"]["task_center_entrance"], .["data"]["function_configs"]["store_go"], .["data"]["function_configs"]["wall_closed"])'
^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$ url jsonjq-response-body 'del(.["data"]["float_advertise"])'
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ url reject-dict
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$ url jsonjq-response-body 'del(.["data"]["placeholder"])'

hostname = app.5eplay.com, ya-api-app.5eplay.com
