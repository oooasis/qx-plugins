^https:\/\/patientgate\.91160\.com\/cube\/v1\/unit_page\/page_data\? url jsonjq-response-body '.data.modules |= map(select(.name == "announcement" or .name == "guide" or .name == "expert" or .name == "featuredDepartments" or .name == "featureDevice" or .name == "featureTech" or .name == "familyDoctor" or .name == "introduction" or .name == "bus" or .name == "classicCase" or .name == "askEveryone" or .name == "reviews" or .name == "notes"))'
^https:\/\/snsapi\.91160\.com\/vipmemberapi\/mbCombo\/mbComboWords\? url reject-dict
^https:\/\/patientgate\.91160\.com\/rec\/homepage\/open\/getUserGoodsList\? url reject-dict
^https:\/\/snsapi\.91160\.com\/hotword\/open\/v1\/getSearchExplore\? url reject-dict
^https:\/\/snsapi\.91160\.com\/hotword\/open\/v1\/getHotWordPlate\? url reject-dict
^https:\/\/snsapi\.91160\.com\/engine\/backgroundWord\/queryForFrontend\? url reject-dict
^https:\/\/patientappapi\.91160\.com\/cus_index\.php\?c=adver url reject

