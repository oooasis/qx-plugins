#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/AiHuiShou.png

^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/search-config url jsonjq-response-body '.data=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dammam-service\/api\/scene-message-template\/pull url jsonjq-response-body '.data.statusCode=1 | .data.params={} | .data.context={} | .data.templateId=0 | .data.eventName=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/config-renew-v3 url jsonjq-response-body '.data.promotionBannerConfigs=[] | .data.homeSecondFloorBanner=[] | .data.yanxuanSlogan=null | .data.recycleSlogan=null'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/my-product-rotate-v2 url jsonjq-response-body '.data.myProductCoupon={"receivableCouponCount":0,"receivableCouponList":[],"userCouponCount":0,"couponPrice":0,"couponCondition":0} | .data.otherCategoriesImg=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/welfare-center\/entry-v2 url jsonjq-response-body '.data.pop=false | .data.receiveStatus=0 | .data.couponPackages=[] | .data.cashBacks=null | .data.taskBonus=null | .data.totalAwardPrice=0 | .data.homeWelfareZone=null | .data.notLoginPopup=null | .data.bgImageUrl=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/activity\/gradient-increase-sniff-v2 url jsonjq-response-body '.data.items=[] | .data.matchedPolicyItem=null | .data.nextPolicyItem=null | .data.inquiryItems=[] | .data.illustrate=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/module-config-v2 url jsonjq-response-body '.data.userCenterAflBanner=null | .data.userCenterLinLiBanner=null | .data.userCenterBottomBanners=[] | .data.activityCarouselMap=[] | .data.inviteNewUserActivity=null | .data.userCenterCommonFunctions=((.data.userCenterCommonFunctions // []) | map(select(.title!="福利中心" and .title!="口令兑换" and .title!="门店加盟")))'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/products\/home\/config url jsonjq-response-body '.data.adBannerList=null | .data.categoryAdBannerList=[] | .data.adBannerImgList=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/channel\/banner url jsonjq-response-body '.data.flowBannerList=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/search\/placeholders-v2 url jsonjq-response-body '.data=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/find-tab-v4 url jsonjq-response-body '.data=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/navbar-v7 url jsonjq-response-body '.data=((.data // []) | map(select(.type!=8 and .type!=9 and .type!=10)))'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/task-center\/show-entrance url jsonjq-response-body '.data.showEntrance=false | .data.unclaimedAmount=0 | .data.expireAmount=null | .data.secondsUntilExpired=null | .data.timeLimitTask=false | .data.showWaitComment=false | .data.fissionBubble=null'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/float-layers\/guide-login-v2 url jsonjq-response-body '.data.id=0 | .data.name="" | .data.interactionMethod=0 | .data.commonLink=null | .data.couponPackageCode=null | .data.imgUrl=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config\/commonConfig url jsonjq-response-body '.data.loginPageConfig.loginNewCouponTips="" | .data.loginPageConfig.loginNewCouponTipsImg="" | .data.loginPageConfig.loginBannerUrl="" | .data.cartHeaderImage="" | .data.promotionCenter.popup=false | .data.promotionCenterV2.popup=false | .data.promotionCenterV2.popupImg="" | .data.promotionCenterV2.popupButtonImg="" | .data.tradeRelievedRecycleAdvantageImage=""'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/shops\/service-station-list-v7 url jsonjq-response-body '.data.customerTagConfig=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/config-center\/search-project url jsonjq-response-body '.data=((.data // []) | map(select(.name=="附近回收机" or .name=="附近门店" or .name=="手机维修" or .name=="帮助中心")))'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/member\/static-config url jsonjq-response-body '.data.memberUserCenter={} | .data.memberWelfareCenter={} | .data.couponTagImgUrl="" | .data.memberInquiry.popTitleImageUrl="" | .data.memberInquiry.popBgImageUrl="" | .data.memberInquiry.popCoupon={}'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/gemini\/grouping url jsonjq-response-body '.data=((.data // []) | map(if .name=="wechat_advertisement" then .group=0 else . end))'
^https:\/\/bi-log\.aihuishou\.com\/trace\/log\/ahs url reject-dict
^https:\/\/ahs-sentry\.aihuishou\.com\/api\/\d+\/envelope\/ url reject-dict
^https:\/\/wirelessgate\.aihuishou\.com\/garage-versional\/sniffer url reject-dict

hostname = dubai-app.aihuishou.com, dubai.aihuishou.com, bi-log.aihuishou.com, ahs-sentry.aihuishou.com, wirelessgate.aihuishou.com
