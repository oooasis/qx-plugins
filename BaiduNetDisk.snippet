#!name = 百度网盘
#!desc = 移除开屏广告、首页卡片广告、传输页面广告、各类弹窗，精简侧拉抽屉和我的页面。（转自可莉 BaiduNetDisk_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduNetDisk.png

^https:\/\/pan\.baidu\.com\/api\/getconfig\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/getsyscfg\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist\? url reject-dict
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry\? url reject-dict
^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/plugin\/get\? url reject-dict
^https:\/\/pan\.baidu\.com\/recommend\/query\/list\? url reject-dict
^https:\/\/pan\.baidu\.com\/feed\/kingkongdistrict\? url jsonjq-response-body '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'

hostname = pan.baidu.com
