#!name = 百度网盘
#!desc = 过滤百度网盘广告，解锁部分SVIP功能。（转自 Loon Lab BaiduNetDisk.lpx，2026-10-02 12:00）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], ddgksf2013[https://github.com/ddgksf2013], chxm1023[https://github.com/chxm1023]
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/BaiduNetDisk.png

^https:\/\/pan\.baidu\.com\/api\/getconfig\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/getsyscfg\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist\? url reject-dict
^https:\/\/pan\.baidu\.com\/act\/api\/activityentry\? url reject-dict
^https:\/\/pan\.baidu\.com\/rest\/\d\.\d\/pcs\/adv\? url reject-dict
^https:\/\/pan\.baidu\.com\/api\/plugin\/get\? url reject-dict
^https:\/\/pan\.baidu\.com\/recommend\/query\/list\? url reject-dict
^https:\/\/pan\.baidu\.com\/feed\/kingkongdistrict\? url jsonjq-response-body '.data.data |= map(select(.type != "novel" and .type != "shortplay" and .type != "print" and .type != "job_hunt"))'
^https?:\/\/.*baidu\.com\/rest\/.*\/membership\/proxy\/guide url reject-200
^https?:\/\/pan\.baidu\.com\/act\/v\d\/(bchannel|welfare)\/list url reject-200
^https:\/\/pan\.baidu\.com\/feed\/hotlist url reject-200
^https?:\/\/.*zhangyuyidong\.cn\/api\/zysdk url reject-200
^https:\/\/pan\.baidu\.com\/queryintent\/queryhint url reject-200
^https:\/\/pan\.baidu\.com\/coins\/center\/notice url reject-200
^https:\/\/pan\.baidu\.com\/recommend\/shortseries\/list url reject-dict
^https?:\/\/afd\.baidu\.com\/afd\/entry url script-response-body https://ddgksf2013.top/scripts/bdpan.ads.js
^https:\/\/pan\.baidu\.com\/feed\/cardinfos url script-response-body https://ddgksf2013.top/scripts/bdpan.ads.js
^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user\?method=gamecenter url script-response-body https://ddgksf2013.top/scripts/bdpan.ads.js
^https?:\/\/pan\.baidu\.com\/(act\/.+\/(activityentry|bchannel|cardwelfare|skin)|rest\/.+\/(membership\/user|pcs\/adv)|feed\/cardinfos|api\/(user\/getinfo|quota|loginstatus|account\/getprivilege)|buy\/ad\/conf|wap\/vip|coins\/taskcenter\/homensr) url script-response-body https://raw.githubusercontent.com/chxm1023/Rewrite/main/bdcloud.js
^https:\/\/pan\.baidu\.com\/api\/streaming\?app_id=\d+&type=M3U8_HQ_1080 url script-request-header https://ddgksf2013.top/scripts/bdpan.unlock.js
^https:\/\/pan\.baidu\.com\/rest\/.*\/membership\/user url script-response-body https://ddgksf2013.top/scripts/bdpan.unlock.js

hostname = pan.baidu.com, afd.baidu.com
