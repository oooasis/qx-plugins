^https:\/\/web\.hibixin\.com\/user-recall\/signModal$ url reject
^https:\/\/api\.hibixin\.com\/config\/v\d\/common\/popup$ url reject-dict
^https:\/\/api\.hibixin\.com\/biggie\/home\/v\d\/query\/biggie$ url jsonjq-response-body '.result.list |= map(select(has("bannerList") and .bannerList == null))'
^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/rec\/card\/query$ url reject-dict
^https:\/\/api\.hibixin\.com\/msg\/user\/friends\/trends\/top$ url reject-dict
^https:\/\/gateway\.xxqapp\.cn\/live\/pendant\/index\/items$ url reject-dict
^https:\/\/api\.xxqapp\.cn\/banner\/list\/\d$ url reject-dict
^https:\/\/api\.hibixin\.com\/resource\/v\d\/discovery\/entrance\/activity$ url reject-dict
^https:\/\/gateway\.hibixin\.com\/config\/search\/qryConfigPart$ url reject-dict
^https:\/\/gateway\.xxqapp\.cn\/live\/flow\/pendant\/meta$ url reject-dict
^https:\/\/web-bxyuer\.bixin\.cn\/yuer-ads\? url reject
^https:\/\/gateway\.bxyuer\.com\/official\/room\/tab\/pop$ url reject-dict
^https:\/\/api\.hibixin\.com\/biggie\/query\/skill\/detail\/relateRecommendBiggieV\d$ url reject-dict
^https:\/\/api\.hibixin\.com\/resource\/v\d\/common\/tab$ url jsonjq-response-body '.result |= map(select(.type != "activityCenter"))'
^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/common\/tab\/query$ url script-response-body https://kelee.one/Resource/JavaScript/Bixin/common_tab.js
^https:\/\/gateway\.hibixin\.com\/resource\/v\d\/my\/page$ url script-response-body https://kelee.one/Resource/JavaScript/Bixin/my_page.js

hostname = web.hibixin.com, api.hibixin.com, gateway.hibixin.com, gateway.xxqapp.cn, api.xxqapp.cn, web-bxyuer.bixin.cn, gateway.bxyuer.com
