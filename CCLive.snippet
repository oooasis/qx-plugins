#!name = CC直播
#!desc = 移除信息流推广和横幅，精简顶部标签。（转自可莉 CCLive_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CCLive.png

^https:\/\/api\.cc\.163\.com\/v\d\/mgamenavigation\/navigation_list\? url jsonjq-response-body '.data.info_list |= map(select(.name == "关注" or .name == "推荐" or .name == "视频" or .name == "全部"))'
^https:\/\/api\.cc\.163\.com\/v\d\/mgamerecpage\/recommend_page\? url jsonjq-response-body '.data.plugins|=map(select(.module_type!="banner"))|.data.plugins|=map(select(.module_type!="show_list"))|.data.plugins|=map(select(.title!="推荐品类"))'
^https:\/\/api\.cc\.163\.com\/v\d\/entpage\/live_navbar_mobile\/ios\? url jsonjq-response-body '.data.top_nav |= map(select(.cn_name == "推荐" or .cn_name == "星秀" or .cn_name == "心动交友"))'
^https:\/\/cc\.163\.com\/act\/m\/daily\/ad_ url reject
^http:\/\/mshare\.cc\.163\.com\/mshare\/startadv_mobile_v\d\? url reject-dict
^https:\/\/appapi\.cc\.163\.com\/v\d\/mixfloatingwindow\/floating_windows\? url reject-dict
^http:\/\/api\.cc\.163\.com\/v1\/mpopuprecommend\/exit_room_conf$ url reject-dict

hostname = api.cc.163.com, cc.163.com, appapi.cc.163.com
