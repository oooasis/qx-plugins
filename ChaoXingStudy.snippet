#!name = 学习通
#!desc = 移除开屏广告、横幅推广，精简校园补给站频道。（转自可莉 ChaoXingStudy_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ChaoXingStudy.png

^https:\/\/learn\.chaoxing\.com\/apis\/service\/appConfig\? url jsonjq-response-body 'del(.["data"]["ad"])'
^https:\/\/home-yd\.chaoxing\.com\/apis\/data\/getAdsRecommend\? url reject-dict
^https:\/\/home-yd\.chaoxing\.com\/apis\/banner\/getConfigInfoForXsqy\? url reject-dict
^https:\/\/apps\.chaoxing\.com\/apis\/home\/getHpXsqy\.jspx\? url jsonjq-response-body '.data.list |= map(select(.pid == 4 or .pid == 44)) | .data.list_xsqy |= map(select(.pid == 4 or .pid == 44)) | .data.list_xysqbj |= map(select(.pid == 4 or .pid == 44)) | .data.lanmu |= map(select(.id == 4 or .id == 44))'
^https:\/\/apps\.chaoxing\.com\/apis\/home\/getHpXsqy\.jspx\? url jsonjq-response-body 'del(.["data"]["list_timeapp"])'
^https:\/\/groupyd2\.chaoxing\.com\/apis\/activity\/getActivitys_attention\? url reject-dict
^https:\/\/appswh\.chaoxing\.com\/apis\/activity\/getNoteTopicList\? url reject-dict

hostname = learn.chaoxing.com, home-yd.chaoxing.com, apps.chaoxing.com, groupyd2.chaoxing.com, appswh.chaoxing.com
