#!name = 触站
#!desc = 移除开屏广告、弹窗广告、各页面横幅推广，移除首页悬浮挂件。（转自可莉 Chuzhan_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Chuzhan.png

^https:\/\/app\.huashi6\.com\/app\/index\/ad\/ url reject-dict
^https:\/\/app\.huashi6\.com\/app\/common\/config$ url jsonjq-response-body '.["data"]["disableAd"] = true | .["data"]["showTopFloatAdvanceTips"] = false'
^https:\/\/app\.huashi6\.com\/app\/common\/config$ url jsonjq-response-body 'del(.["data"]["adsConfigIOS"], .["data"]["adsConfigAndroid"], .["data"]["url"]["tabMarket"])'
^https:\/\/app\.huashi6\.com\/app\/common\/layouts$ url jsonjq-response-body '.data |= {CZ_MINE_MENUS: .CZ_MINE_MENUS}'
^https:\/\/app\.huashi6\.com\/app\/common\/themeConfig$ url jsonjq-response-body '.data.tabbars |= map(select(.title != "商城"))'
^https:\/\/app\.huashi6\.com\/app\/works\/relative$ url reject-dict
^https:\/\/app\.huashi6\.com\/app\/index\/follow\/all_random\/list$ url reject-dict
^https:\/\/app\.huashi6\.com\/app\/index\/csyxh\/icon$ url reject-dict

hostname = app.huashi6.com
