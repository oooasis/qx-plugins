^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/flash url reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/ai url reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v\d\/search\/get url reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/category\/list-daily url reject-dict
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/related-podcast\/list$ url jsonjq-response-body '.data=[]'
^https:\/\/api\.xiaoyuzhoufm\.com\/v1\/discovery-feed\/list url jsonjq-response-body '.data |= map(select(.type != "DISCOVERY_HEADER" and .type != "DISCOVERY_BANNER" and .type != "DISCOVERY_COVER_BANNER"))'
^https?:\/\/api\.xiaoyuzhoufm\.com\/v1\/(related-episode|operation-resource)\/list url jsonjq-response-body '.data = []'

hostname = api.xiaoyuzhoufm.com
