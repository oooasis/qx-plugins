^https:\/\/dataapi\.yoloho\.com\/tool\/card\/mine\/app\? url jsonjq-response-body '.data |= map(select(.type == "1"))'
^https:\/\/shop18476221\.m\.youzan\.com\/wscshop\/showcase\/feature\? url reject

hostname = forumapi.yoloho.com, dataapi.yoloho.com, shop18476221.m.youzan.com
