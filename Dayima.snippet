^https:\/\/forumapi\.yoloho\.com\/index\/recommend\/listV\d\? url jsonjq-response-body '.recommendList |= map(select(.voType == 0))'
^https:\/\/dataapi\.yoloho\.com\/tool\/bubble\/event\/new\/iconList\? url jsonjq-response-body '.data |= map(select(.id == 21 or .id == 23 or .id == 24 or .id == 40))'
