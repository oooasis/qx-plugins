#!name = 叮咚买菜
#!desc = 移除开屏广告、弹窗推广、搜索推荐、信息流广告、悬浮广告、各页面购物推荐、精简我的页面，移除底栏和各页面AI入口。（转自可莉 DingdongMaicai_remove_ads.lpx，2026-10-02 13:57:49）
#!author = zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], wish
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DingdongMaicai.png

host, trackercollect.ddxq.mobi, reject
host, ddfs-public.ddimg.mobi, reject
host, rttrack.ddxq.mobi, reject
^https?:\/\/119\.29\.29\.\d+\/d url reject-200
^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/ url reject
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop url reject
^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rollHotKeyword\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/rankingList\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/search\/hotKeyword\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/order\/getRecommend$ url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/userLike\? url reject-dict
^https:\/\/user\.api\.ddxq\.mobi\/userportal-service\/api\/v1\/user\/queryMyPage\/\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\? url jsonjq-response-body 'del(.["data"]["ad_info"])'
^https:\/\/maicai\.api\.ddxq\.mobi\/tool\/getConfig\? url jsonjq-response-body 'del(.["data"]["ai_enter_config"])'
^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/userLike\/flowData$ url reject-dict
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? url jsonjq-response-body 'del(.["data"]["top_advert_data"], .["data"]["suspension"])'
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? url jsonjq-response-body '.data.list |= map(select(has("capsule_freedom_zone") | not))'
^https:\/\/maicai\.api\.ddxq\.mobi\/guide-service\/productApi\/productDetail\/info\? url jsonjq-response-body 'del(.["data"]["detail"]["chatEntry"])'
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/bottomNavi url jsonjq-response-body 'del(.data.adId?) | if (.data.bottom_list? | length > 0) then .data.bottom_list |= map(select(.type != "eatwhat")) else . end'
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail url jsonjq-response-body 'walk(if type == "object" and has("list") then .list |= map(if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end) else . end)'

hostname = 119.29.29.*, maicai.api.ddxq.mobi, user.api.ddxq.mobi
