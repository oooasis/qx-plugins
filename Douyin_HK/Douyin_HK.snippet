^https:\/\/api5-normal-lq\.amemv\.com\/api\/ad\/ url reject
^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/api\/ad\/ url reject
^https:\/\/zlink\.ugsdk\.cn\/ad\/ url reject
^https:\/\/((aweme\.snssdk\.com|api5-normal-m\.amemv\.com)|api5-normal-m\.amemv\.com)\/aweme\/homepage\/sidebar_data\/\? url jsonjq-response-body 'del(.["data_map"]["recently_apps"], .["data_map"]["recently_users"])'
^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/render\/\? url jsonjq-response-body 'del(.["data"]["tab_config"])'
^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/aweme\/homepage\/render\/\? url jsonjq-response-body '.data.tab_list[]? |= (if .extra.side_bar.modules != null then .extra.side_bar.modules[]?.items[]? |= (if .data.first_page_module?.module_title == "常用功能" then .data = {} else . end) else . end) | .data.tab_list |= map(if .extra.tab_list != null then .extra.tab_list |= map(select(.tab_id | IN("homepage_tablive", "homepage_follow", "homepage_hot_container"))) else . end) | .data.tab_list |= map(select(.extra.tab_list != null and (.extra.tab_list | length > 0)))'
^https:\/\/(aweme\.snssdk\.com|api5-normal-m\.amemv\.com)\/tfe\/api\/request_combine\/v1\/\?need_personal_recommend url jsonjq-response-body '.["data"]["/service/settings/v3/"]["body"]["data"]["settings"]["homepage_two_session_tab_skin_2025"] = false | .["data"]["/service/settings/v3/"]["body"]["data"]["settings"]["homepage_tab_skin_enable"] = false'

hostname = aweme.snssdk.com, api5-normal-m.amemv.com
