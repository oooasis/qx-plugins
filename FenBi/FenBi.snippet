#!name = 粉笔
#!desc = 过滤粉笔广告（转自 Loon Lab FenBi.lpx，2026-10-02 12:00）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], sooyaaabo[https://github.com/sooyaaabo]
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/FenBi.png

^https:\/\/keapi\.fenbi\.com\/app\/(?:iphone|ipad)\/position_resource\/get_banners\? url reject-dict
^https:\/\/market-api\.fenbi\.com\/(?:iphone|ipad)\/v1\/assistant\/info\? url reject-dict
^https:\/\/keapi\.fenbi\.com\/app\/(?:iphone|ipad)\/position_resource\/get_home_banners_v2\? url jsonjq-response-body 'del(.data[1], .data[0].payload.bannerString) | .data[0].payload.items = [.data[0].payload.items[0] | .imageUrl = "https://i.im.ge/QQuZ4WS/FBBanner.png" | .content = "粉笔-遇见不一样的自己"] | .data[0].payload.count = 1'
^https:\/\/keapi\.fenbi\.com\/app\/(?:iphone|ipad)\/\w+\/reddot\? url reject-dict
^https:\/\/ke\.fenbi\.com\/(?:iphone|ipad)\/v3\/timetable\/today_with_public_episodes\? url reject-dict
^https:\/\/hera-webapp\.fenbi\.com\/(?:iphone|ipad)\/topic\/hotquery\/list\? url reject-dict
^https:\/\/hera-webapp\.fenbi\.com\/(?:iphone|ipad)\/explore\/consts\? url reject-dict
^https:\/\/hera-webapp\.fenbi\.com\/(?:iphone|ipad)\/recommend\/info\? url jsonjq-response-body 'del(.["data"]["rollingBanner"])'
^https:\/\/hera-webapp\.fenbi\.com\/(?:iphone|ipad)\/announcement\/hotquery\/list\? url reject-dict
^https:\/\/ke\.fenbi\.com\/(?:iphone|ipad)\/v3\/apps\/config\? url jsonjq-response-body 'del(.["data"]["bottomIconInfos"]["position"]["iconDefaultUrl"], .["data"]["bottomIconInfos"]["position"]["iconSelectedUrl"], .["data"]["bottomIconInfos"]["position"]["nightModeIconDefaultUrl"], .["data"]["bottomIconInfos"]["position"]["nightModeIconSelectedUrl"])'
^https:\/\/ke\.fenbi\.com\/(?:iphone|ipad)\/v3\/user_member\/entry\? url reject-dict
^https:\/\/market-api\.fenbi\.com\/(?:iphone|ipad)\/v1\/assistant\/my\? url reject-dict
^https:\/\/ke\.fenbi\.com\/(?:iphone|ipad)\/v3\/remind\/instant\? url reject-dict
^https:\/\/keapi\.fenbi\.com\/ai\/(?:iphone|ipad)\/exercise_remark\/get_questions_remark\? url reject-dict
^https:\/\/keapi\.fenbi\.com\/app\/(?:iphone|ipad)\/position_resource\/get_tiku_banners\? url reject-dict

hostname = keapi.fenbi.com, market-api.fenbi.com, ke.fenbi.com, hera-webapp.fenbi.com
