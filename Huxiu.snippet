#!name = 虎嗅
#!desc = 移除广告配置、信息流直播预约横幅、相关文章推荐、48小时热文推荐，精简搜索页面。（转自可莉 Huxiu_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Huxiu.png

host, api-ad-product.huxiu.com, reject
^https:\/\/api-ms-config\.huxiu\.com\/v1\/adConfig$ url reject-dict
^https:\/\/api-web-feed\.huxiu\.com\/v1\/index\/recommendContentsNew$ url reject-dict
^https:\/\/api-ms-feed\.huxiu\.com\/v1\/media\/recommend$ url jsonjq-response-body 'del(.["data"]["live"])'
^https:\/\/api-search\.huxiu\.com\/api\/searchIndex$ url reject-dict
^https:\/\/api-article\.huxiu\.com\/v2\/article\/getTextArticleRelated$ url reject-dict
^https:\/\/api-web-moment\.huxiu\.com\/v3\/moment\/getDetailRecdArticle$ url reject-dict

hostname = api-ms-config.huxiu.com, api-web-feed.huxiu.com, api-ms-feed.huxiu.com, api-search.huxiu.com, api-article.huxiu.com, api-web-moment.huxiu.com
