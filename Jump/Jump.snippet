#!name = Jump
#!desc = 移除Jump开屏广告（转自可莉 Jump_remove_ads.lpx，2026-10-02 13:57:49）
#!author = MoonYuki[https://github.com/MoonYuki]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Jump.png

host, zlsdk.1rtb.net, reject
host, jp.ad.gameley.com, reject
host, toblog.ctobsnssdk.com, reject
host, s3plus.meituan.net, reject
host, images.pinduoduo.com, reject
host, qh-material.taobao.com, reject
host-suffix, admobile.top, reject
^https:?\/\/switch.jumpvg.com\/jump\/getlaunchad\/v2$ url jsonjq-response-body 'del(.data.adList)|.data.launchAd.showType=0'
^https:?\/\/switch.jumpvg.com\/jump\/recommend\/ad_conf$ url jsonjq-response-body '.data=[]'

hostname = switch.jumpvg.com
