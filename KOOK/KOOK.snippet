#!name = KOOK
#!desc = 移除开屏广告、房间横幅推广、促销活动、精简发现页面频道及我的页面，移除底栏商城入口。（转自可莉 KOOK_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KOOK.png

^https:\/\/www\.kookapp\.cn\/api\/v3\/ad\/config$ url reject-dict
^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ url jsonjq-response-body 'del(.["ad_banner"], .["advertise_on_off"])'
^https:\/\/(m|www)\.kookapp\.cn\/api\/v\d\/user\/settings$ url jsonjq-response-body '.["ios_mall_switch"] = false'
^https:\/\/www\.kookapp\.cn\/api\/v3\/promotion\/ongoing$ url reject-dict
^https:\/\/www\.kookapp\.cn\/api\/v3\/discover\/tab-list\? url jsonjq-response-body '.data.items |= map(select(.id == 472 or .id == 473 or .id == 475))'

hostname = www.kookapp.cn, m.kookapp.cn
