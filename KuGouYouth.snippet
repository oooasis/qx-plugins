#!name = 酷狗概念版
#!desc = 移除广告服务模块、播放器广告，精简乐库及搜索页面。（转自可莉 KuGouYouth_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/KuGouYouth.png

^https:\/\/gateway\.kugou\.com\/ads\.service\/ url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/v1\/start_img\/last\? url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/v1\/yueku\/tab\? url jsonjq-response-body '.data.responses |= map(select(.module == "new_song_publish" or .module == "song_rank"))'
^https:\/\/gateway\.kugou\.com\/ads\.gateway\/ url reject-dict
^http:\/\/mobilelog\.kugou\.com\/adtrackconfig\.json$ url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/v1\/experiment\/get_params\? url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/api\/user\/v1\/init\? url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/v2\/activity\/task_list\? url reject-dict
^https:\/\/gateway\.kugou\.com\/youth\/v1\/channel\/tab_list\? url reject-dict
^https:\/\/gateway\.kugou\.com\/goddess\/v1\/content\/biz_list\? url reject-dict

hostname = gateway.kugou.com
