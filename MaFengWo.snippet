#!name = 马蜂窝去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 501 行，[M] 段；追加 kelee:MaFengWo_remove_ads.lpx（2026-10-02 13:57:49）的 4 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https://mapi.mafengwo.cn\/ad\/get_launch_ad_list\/v2 url reject-200

# ↓ 来自 kelee:MaFengWo_remove_ads.lpx「马蜂窝去广告」
host, advert.mafengwo.cn, reject
^https:\/\/mapi\.mafengwo\.cn\/discovery\/get_index\/v7\? url jsonjq-response-body '.data.list |= map(select(.data.business_type != "gdcpm"))'
^https:\/\/mapi\.mafengwo\.cn\/sales\/home\/get_header\/v3\? url jsonjq-response-body '.data.list[] |= ( .data |= del(.banners) )'
^https:\/\/mapi\.mafengwo\.cn\/user\/growth\/get_growth_tip\/v1\? url reject-dict

hostname = mapi.mafengwo.cn
