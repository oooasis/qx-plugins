#!name = 网易邮箱大师
#!desc = 移除网易邮箱大师开屏广告、签到任务提醒，精简侧拉抽屉和我的页面。（转自可莉 MailMaster_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/MailMaster.png

^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$ url reject-dict
^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/page\/v2\/conf\.do$ url jsonjq-response-body 'del(.["data"]["functionOperatorInfoList"], .["data"]["memberOperator"], .["data"]["activityTabInfoList"])'
^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/config\/function\.do$ url jsonjq-response-body '.data.config[] |= if .result.tools then .result.tools |= map(select(.name == "邮件追踪" or .name == "替身邮箱")) else . end | del(.data.config[] | select(.functionName == "Function-AD"))'
^https:\/\/dashi\.163\.com\/task-center-api\/fapi\/task\/list$ url reject-dict
^https:\/\/appconf\.mail\.163\.com\/mailoperating\/mailmaster\/api\/operator\/get$ url reject-dict

hostname = appconf.mail.163.com, dashi.163.com
