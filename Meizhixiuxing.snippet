#!name = 美丽修行
#!desc = 移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。（转自可莉 Meizhixiuxing_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Meizhixiuxing.png

^https:\/\/api\.bevol\.com\/appmain\/app\/home\/launch$ url reject-dict
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/popup$ url reject-dict
^https:\/\/api\.bevol\.com\/personal\/page$ url reject-dict
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/page$ url jsonjq-response-body 'del(.["result"]["versionPopUp"], .["result"]["isShowSearchLabel"], .["result"]["isShowSearchFeedBack"], .["result"]["centerBannerAdvert"], .["result"]["programmaticAdvertising"], .["result"]["mattsData"], .["result"]["questionnaireMap"], .["result"]["appPullDownAdvert"])'
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ url jsonjq-response-body 'del(.["result"]["banners"])'
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$ url jsonjq-response-body '. | .result.returnList |= (map(select(.tname == "userPart"))) | .result.returnList |= map(select(. | has("adId") | not))'
^https:\/\/api\.bevol\.com\/trialbox\/shop\/app\/homePage$ url jsonjq-response-body 'del(.["result"]["firstPersonActivity"], .["result"]["mainActivity"], .["result"]["brandZone"], .["result"]["imageAD2"], .["result"]["couponPopupInfo"])'
^https:\/\/api\.bevol\.com\/seach\/foundAndTopSearch$ url reject-dict

hostname = api.bevol.com
