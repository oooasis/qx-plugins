#!name = 脉脉去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 515 行，[M] 段；追加 kelee:MaiMai_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/open\.taou\.com\/maimai\/launch_ad url reject-200
^https?:\/\/api\.taou\.com\/sdk\/global\/splash_ad url reject-200
^https?:\/\/track\.mm\.taou\.com/v\d\/track url reject-200

# ↓ 来自 kelee:MaiMai_remove_ads.lpx「脉脉去广告」
^https:\/\/(h3\.)?open\.taou\.com\/maimai\/adshow\? url reject-dict
^https:\/\/(h3\.)?open\.taou\.com\/maimai\/(feed|gossip)\/v\d\/(focus_feed|gossip_detail_comment|feed_detail_comment?)\? url script-response-body https://kelee.one/Resource/JavaScript/MaiMai/MaiMai_remove_ads.js

hostname = open.taou.com, api.taou.com, track.mm.taou.com, h3.open.taou.com
