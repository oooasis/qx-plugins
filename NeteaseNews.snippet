host, nex.163.com, direct
host, gw.m.163.com, direct
^https?:\/\/interface\.music\.163\.com\/eapi\/ad url reject
^https?:\/\/c\.m\.163\.com\/nc\/gl\/ url reject
^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/searchMultiAds url reject
^https?:\/\/g1\.163\.com\/madfeedback url reject
^https?:\/\/interface\.music\.163\.com\/eapi\/ad\/ url reject
^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia\.json url reject
^https?:\/\/interface3?\.music\.163\.com\/eapi\/(ad|abtest|sp|hot|store|search\/(specialkeyword|defaultkeyword|hot)) url reject
^https:\/\/nex\.163\.com\/q url script-response-body https://kelee.one/Resource/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js
^https:\/\/gw\.m\.163\.com\/nc\/api\/v1\/feed\/dynamic\/headline-list\? url script-response-body https://kelee.one/Resource/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js
^https:\/\/gw\.m\.163\.com\/nc\/api\/v1\/search\/hot-word url script-response-body https://kelee.one/Resource/JavaScript/NeteaseNews/NeteaseNews_remove_ads.js

hostname = interface.music.163.com, c.m.163.com, client.mail.163.com, g1.163.com, support.you.163.com, nex.163.com, gw.m.163.com
