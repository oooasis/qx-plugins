^https:\/\/api\.qbb6\.com\/commons\/main\/tab\/info\/get\? url reject-dict
^https:\/\/apicommunity\.qbb6\.com\/community\/recommend\/user\/get\? url reject-dict
^https:\/\/apipt\.qbb6\.com\/parenting\/pt\/home\/post\/card\/get\? url reject-dict
^https:\/\/apipt\.qbb6\.com\/lib\/search\/hot\/keys\/v\d\? url reject-dict
^https:\/\/apiuser\.qbb6\.com\/user\/member\/info\/get\? url reject-dict
^https:\/\/apimall\.qbb6\.com\/mall\/v\d\/goods\/count\? url reject-dict
^https:\/\/apimall\.qbb6\.com\/mall\/homepage\/data\/get\/v\d$ url reject-dict

# ↓ 兜底：来自墨鱼 StartUpAds（qinbaobao）
^https?:\/\/api\.qbb6\.com\/ad\/ url reject-200

hostname = api.qbb6.com, apicommunity.qbb6.com, apipt.qbb6.com, apiuser.qbb6.com, apimall.qbb6.com
