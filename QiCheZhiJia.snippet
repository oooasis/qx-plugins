#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/adproxy.autohome.com.cn\/AdvertiseService\/ url reject-200
^https?:\/\/app2.autoimg.cn\/appdfs\/ url reject-200

# ↓ 来自 kelee:AutoHome_remove_ads.lpx「汽车之家去广告」
^https:\/\/pcmx\.autohome\.com\.cn\/queryCreativeList url reject-dict
^https:\/\/maam\.pingan\.com\.cn\/maam\/buoy\/getBuoyList\.do url reject-dict
^https:\/\/adproxy\.autohome\.com\.cn\/AdvertiseService\/AppHandler\.ashx url reject-dict
^https:\/\/news\.app\.autohome\.com\.cn\/news_v\d+(?:\.\d+){2}\/news\/homenavigation url script-response-body https://kelee.one/Resource/JavaScript/AutoHome/AutoHome_remove_ads.js
^https:\/\/(a\.athm\.cn\/)?club\.app\.autohome\.com\.cn\/club_v\d+(?:\.\d+){2}\/club\/index\/businessv\d+ url script-response-body https://kelee.one/Resource/JavaScript/AutoHome/AutoHome_remove_ads.js
^https:\/\/(a\.athm\.cn\/)?apiautoappusc\.che168\.com\/apic\/v\d+\/gethomepagefeed url script-response-body https://kelee.one/Resource/JavaScript/AutoHome/AutoHome_remove_ads.js

hostname = app2.autoimg.cn, adproxy.autohome.com.cn, apiautoappusc.che168.com, club.app.autohome.com.cn, maam.pingan.com.cn, news.app.autohome.com.cn, pcmx.autohome.com.cn
