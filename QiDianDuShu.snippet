#!name = 起点读书去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 624 行，[Q] 段；追加 kelee:QiDian_remove_ads.lpx（2026-10-02 13:57:49）的 6 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/magev\d\.if\.qidian\.com\/argus\/api\/v\d\/client\/getsplashscreen url reject-200

# ↓ 来自 kelee:QiDian_remove_ads.lpx「起点读书去广告」
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/client\/getconf$ url jsonjq-response-body 'del(.["Data"]["ActivityPageBackPushNoticeFrequency"], .["Data"]["ActivityIcon"], .["Data"]["ActivityPopup"], .["Data"]["LuckBag"])'
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/adv\/ url reject-dict
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/push\/getdialog\? url reject-dict
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/message\/getpushedmessagelist$ url reject-dict
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/bookshelf\/getTopOperation$ url reject-dict
^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/v1\/followsubscribe\/showChapterEndModule\? url reject-dict

hostname = mage*.if.qidian.com, magev6.if.qidian.com
