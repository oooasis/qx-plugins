#!name = 七猫小说
#!desc = 移除大部分七猫小说广告，但受限于七猫小说自身对MitM和VPN状态的检测，部分页面广告无法移除。（转自可莉 SevenCat_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/SevenCat.png

host, cdn-ad.wtzw.com, reject
host, cdn-new-ad.wtzw.com, reject
host-suffix, gdt.qq.com, reject
^https:\/\/api-cfg\.wtzw\.com\/v\d\/splash\/ url reject-dict
^https:\/\/api-bc\.wtzw\.com\/api\/v4\/search\/dispose url reject-dict
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/config url reject-dict
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/book-store\/push-book url reject-dict
^https:\/\/api-bc\.wtzw\.com\/api\/v\d\/operation url reject-dict
^https:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/ url reject
^https:\/\/api-gw\.wtzw\.com\/welf\/app\/v\d\/task\/red-packet url reject-dict
^https:\/\/cdn\.wtzw\.com\/bookimg\/free\/api\/v\d\/reader\/reader-copy-paragraph-all\.json url reject-dict
^https:\/\/api-cfg\.wtzw\.com\/v\d\/reward\/ url reject
^https:\/\/api-cfg\.wtzw\.com\/v\d\/adv\/ url reject
^https:\/\/api-cfg\.wtzw\.com\/v\d\/offline-adv\/index url reject-dict
^https:\/\/api-cfg\.wtzw\.com\/v\d\/operation\/index\?ad_personal_switch url reject-dict
^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/withdraw\/init url reject-dict
^https:\/\/xiaoshuo\.wtzw\.com\/api\/v\d\/user\/my-center\? url jsonjq-response-body 'del(.["data"]["func_area"][1], .["data"]["func_area"][2])'

hostname = api-cfg.wtzw.com, api-bc.wtzw.com, sf3-fe-tos.pglstatp-toutiao.com, api-gw.wtzw.com, cdn.wtzw.com
