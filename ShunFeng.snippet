#!name = 顺丰速运去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 676 行，[S] 段；追加 kelee:SF-Express_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appVersion\/detectionUpgrade url reject-200
https://ccsp-egmas.sf-express.com/cx-app-base/base/app/ad/queryInfoFlow url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/shunfeng_json.js
https://ccsp-egmas.sf-express.com/cx-app-base/base/app/ad/queryAdImages url reject-200
^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen url reject-200

# ↓ 来自 kelee:SF-Express_remove_ads.lpx「顺丰速运去广告」
^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/ad\/ url reject-dict
^https:\/\/ccsp-egmas\.sf-express\.com\/cx-app-base\/base\/app\/appHomeConfig\/query$ url jsonjq-response-body '.obj |= map(select(.position != 2))'

hostname = ccsp-egmas.sf-express.com
