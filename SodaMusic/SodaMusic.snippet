#!name = 汽水音乐
#!desc = 过滤汽水音乐广告（转自 Loon Lab SodaMusic.lpx，2026-10-02 12:00）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/sooyaaabo/IconLibrary/main/App/SodaMusic.png

^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\? url jsonjq-response-body '.["data"]["opaque_data_enabled"] = 0 | .["data"]["ttnet_http_dns_enabled"] = 0 | .["data"]["ttnet_quic_enabled"] = 0 | .["data"]["ttnet_tt_http_dns"] = 0'
^https:\/\/tnc\d-(bjlgy|ali[a-z]{2})\d?\.zijieapi\.com\/get_domains\/v\d\/\? url jsonjq-response-body '.data.ttnet_dispatch_actions |= map(select(.action != "dispatch" and .action != "tc"))'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/commerce\/upsells_config\? url reject-dict
^https:\/\/(api|api5-lq)\.qishui\.com\/luna\/ads\/ url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.com\/luna\/ads\/ url reject-dict
^https:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/feed\/\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/treasure\/entrance\/config\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/me\? url jsonjq-response-body 'del(.["reward_ad_banner"])'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/activities\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/feed\/song-tab\? url jsonjq-response-body 'del(.items[] | select(.type == "video_track_mix"))'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/card\? url jsonjq-response-body 'del(.["preview_guide"])'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/card\? url jsonjq-response-body 'del(.card_items[] | select(has("priority_display")))'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/media_ads\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/more-panel\? url jsonjq-response-body '.blocks |= map(select(.type != "related_video"))'
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/commerce\/upsells\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/commerce\/v2\/commerce_info\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/listen-video\/reminder\? url reject-dict
^https:\/\/(beta-luna\.douyin|api5-lq\.qishui)\.douyin\.com\/luna\/me\/recently-played-media\? url script-response-body https://kelee.one/Resource/JavaScript/SodaMusic/SodaMusic_remove_ads.js

hostname = beta-luna.douyin.com, api5-lq.qishui.com, api.qishui.com, webcast-open.douyin.com
