#!name = 腾讯视频
#!desc = 过滤腾讯视频客户端广告，如遇失效，则需要重新安装腾讯视频客户端。由于此插件不再维护，客户端版本高于8.9.40可能会导致此插件失效，请勿升级客户端。（转自可莉 Tencent_Video_remove_ads.lpx，2026-10-02 13:57:49）
#!author = RuCu6[https://github.com/RuCu6]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Tencent_Video.png

host, adsmind.gdtimg.com, reject
host, info4.video.qq.com, reject
host, info6.video.qq.com, reject
host, ios.video.mpush.qq.com, reject
host, otheve.beacon.qq.com, reject
host, pgdt.gtimg.cn, reject
host, tpns.qq.com, reject
host, vv6.video.qq.com, reject
host-suffix, gdt.qq.com, reject
host-suffix, l.qq.com, reject
host-keyword, trace.qq.com, reject
host-keyword, trace.video.qq.com, reject
ip-cidr, 47.110.187.87/32, reject
^http:\/\/[\d\.:]*\/?(defaultts\.tc|vmind\.qqvideo\.tc|finderpdd\.video)\.qq\.com\/\w+ url reject
^http:\/\/apd-vlive\.apdcdn\.tc\.qq\.com\/vmind\.qqvideo\.tc\.qq\.com\/\w+ url reject
^http:\/\/apd-\w+\.v\.smtcdns\.com\/(defaultts|omts|vmind\.qqvideo)\.tc\.qq\.com\/\w+ url reject
^https?:\/\/vv\.video\.qq\.com\/(diff|get)vmind url reject-dict

hostname = vv.video.qq.com
