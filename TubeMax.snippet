host, app.tubemaxapp.com, proxy
host-suffix, adjust.com, reject
host-suffix, applvn.com, reject
host-suffix, app-measurement.com, reject
host-suffix, pangle.io, reject
host-suffix, applovin.com, reject
host-suffix, appier.net, reject
host-suffix, adsmoloco.com, reject
host-suffix, adcanvas.com, reject
^https:\/\/.*\.i18n-pglstatp\.com\/obj\/ad-pattern-sg url reject

hostname = *.i18n-pglstatp.com
