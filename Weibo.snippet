#!name = 微博
#!desc = 过滤微博广告及去除各部分推广模块（转自可莉 Weibo_remove_ads.lpx，2026-10-02 13:57:49）
#!author = RuCu6[https://github.com/RuCu6], zmqcherish[https://github.com/zmqcherish]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weibo.png

host-suffix, uve.weibo.com, direct
host, huodong.weibo.cn, reject
host-suffix, biz.weibo.com, reject
^https:\/\/api\.weibo\.cn\/2\/(?:ug\/checkin\/list|push\/daily|push\/info) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/live\/media_homelist\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/comments\/bullet_screens\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/photo\/info\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_positive|push_info) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/vote\/get_vote_detail\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/chaohua\/discovery\/home_bottom\/switch\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/wbox\/\w+\/(?:home_bottom_modal|interest_category) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_discover|finder_nav_polling)\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/hot\/hours_spotlight\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/video\/redpacket\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/!\/(?:search\/finder_nav_polling|sug\/list\/finderchange|was\/finder\/searchbarchange)\? url reject-dict
^https:\/\/api\.weibo\.cn\/2\/video\/tiny_video_info_show\? url reject-dict
^https:\/\/bootrealtime\.uve\.weibo\.com\/v[23]\/ad\/realtime url reject-dict
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info\.php|sdkconfig\.php) url reject-dict
^https:\/\/card\.weibo\.com\/article\/m\/aj\/(?:reward|uvead) url reject-dict
^https:\/\/weibo\.com\/ttarticle\/x\/m\/aj\/(?:reward|uvead) url reject-dict
^https:\/\/api\.weibo\.cn\/2\/(?:checkin\/show|client\/publisher_list|push\/active) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/groups\/allgroups\/v2\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/(?:cardlist|page) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/comments\/build_comments\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/(?:container\/asyn|flowlist|flowpage) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/friendships\/(?:create|destroy) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/profile\/(?:container_timeline|dealatt|me|statuses\/tab|userinfo) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/shproxy\/chaohua\/discovery\/searchactive\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:comments_expand_child|container_detail_comment) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:container_detail\?|container_timeline(?:_hot|_topic|_topicpage|_unread)?|repost_timeline|unread_hot_timeline) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/statuses\/(?:extend|show)\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/video\/(?:full_screen_stream|tiny_stream_mid_detail|tiny_stream_video_list)\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/!\/huati\/discovery_home_bottom_channels\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/direct_messages\/user_list\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/messageflow\/notice\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/search\/(?:container_timeline|finder)\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/api\.weibo\.cn\/2\/searchall\? url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/bootpreload\.uve\.weibo\.com\/v[12]\/ad\/preload url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/sdkad\.php url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js
^https:\/\/wbapp\.uve\.weibo\.com\/(?:preload\/get_ad|wbapplua\/wbpullad\.lua) url script-response-body https://kelee.one/Resource/JavaScript/Weibo/Weibo_remove_ads.js

hostname = api.weibo.cn, bootrealtime.uve.weibo.com, sdkapp.uve.weibo.com, card.weibo.com, weibo.com, bootpreload.uve.weibo.com, wbapp.uve.weibo.com
