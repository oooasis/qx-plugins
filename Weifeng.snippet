#!name = 威锋去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 800 行，[W] 段；追加 kelee:WPForum_remove_ads.lpx（2026-10-02 13:57:49）的 1 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/api\.wfdata\.club\/v2\/yesfeng\/(infoCenterAd|yesList) url reject-200

# ↓ 来自 kelee:WPForum_remove_ads.lpx「威锋去广告」
^https:\/\/api\.wfdata\.club\/v2\/yesfeng\/slideshow\? url jsonjq-response-body '.data |= map(select(.protocolId == 1))'

hostname = api.wfdata.club
