#!name = 小黑盒
#!desc = 移除开屏广告和热点板块信息流广告（转自可莉 XiaoHeiHe_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/XiaoHeiHe.png

^https:\/\/api\.xiaoheihe\.cn\/account\/get_ads_info_v2 url reject-dict
^https:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/news url jsonjq-response-body '.result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)'

hostname = api.xiaoheihe.cn
