#!name = 小睡眠去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 836 行，[X] 段；追加 kelee:HeartideBrainWave_remove_ads.lpx（2026-10-02 13:57:49）的 7 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/api.psy-1.com\/cosleep\/startup url reject-200

# ↓ 来自 kelee:HeartideBrainWave_remove_ads.lpx「小睡眠去广告」
^https:\/\/api\.psy-1\.com\/cosleep\/ad\/ url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/user\/identity\/ad\? url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/discover\/ad$ url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/home\/activity\? url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/ad\/ url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/my\/ad\? url reject-dict
^https:\/\/api\.psy-1\.com\/cosleep\/newborn\/sleeps\/guides\/banner\? url reject-dict

hostname = api.psy-1.com
