#!name = YY
#!desc = 移除开屏广告、应用内弹窗，精简底栏和我的页面。（转自可莉 YY_Voice_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/YY_Voice.png

host, splash.yy.com, reject
host, dsp-ad.yy.com, reject
host, ysad.yy.com, reject
^https:\/\/yyapp-fastnet\.yy\.com\/dispatch\? url reject-dict
^https:\/\/data\.3g\.yy\.com\/popup\/topLiveCardPopup\? url reject-dict
^https:\/\/yyapp-act-entrance\.yy\.com\/entrance\/list\? url reject-dict
^https:\/\/yyapp-idx\.yy\.com\/mobyy\/nav\/index\/idx\? url jsonjq-response-body '.data[].modules |= map(select(.name != "新版本滚动条" and .name != "通栏轮播" and .name != "新静默位"))'
^https:\/\/tab\.yy\.com\/tabs\? url jsonjq-response-body 'del(.["data"]["tabsForSelect"])'
^https:\/\/tab\.yy\.com\/tabs\? url jsonjq-response-body '.data.tabs |= map(select(.alias == "follow" or .alias == "im" or .alias == "me"))'
^https:\/\/personal-center\.yy\.com\/personalCenter\/list\? url jsonjq-response-body '.data.modules |= map(select(.moduleName != "Banner轮播")) | .data.modules |= map(if has("entrances") then .entrances |= map(select(.bizCode|IN("jishijiedaikuan","duxiaoman2","chongzhi","freeData")|not)) else . end)'

hostname = yyapp-fastnet.yy.com, data.3g.yy.com, yyapp-act-entrance.yy.com, yyapp-idx.yy.com, tab.yy.com, personal-center.yy.com
