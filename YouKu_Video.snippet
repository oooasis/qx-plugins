^https:\/\/un-acs\.youku\.com\/gw\/mtop\.youku\.play\.ups\.appinfo\.get url jsonjq-response-body 'del(.["data"]["data"]["ad"], .["data"]["data"]["watermark"], .["data"]["data"]["ykad"])'
^https:\/\/push\.m\.youku\.com\/collect-api\/get_push_interval_config_wx\? url jsonjq-response-body 'del(.["data"]["tipContent"], .["data"]["tipContentNew"])'

hostname = un-acs.youku.com, push.m.youku.com
