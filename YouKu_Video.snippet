host, cad.youku.com, reject
host, ykad-data.youku.com, reject
host, amdc.m.youku.com, reject
host, nbsdk-baichuan.alicdn.com, reject
host, youku-crm-product.youku.com, reject
host, dr-danmu.youku.com, reject
host, group-ssl-danmu-ori.youku.com, reject
