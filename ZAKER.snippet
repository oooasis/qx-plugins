#!name = ZAKER
#!desc = 移除开屏广告、置顶轮播图广告和文末广告。（转自可莉 ZAKER_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZAKER.png

^https:\/\/iphone\.myzaker\.com\/zaker\/cover\.php\? url reject-dict
^https:\/\/iphone\.myzaker\.com\/zaker\/article_mongo_sec\.php\? url jsonjq-response-body 'del(.["data"]["ad_url"])'
^https:\/\/ggs\.myzaker\.com\/zk_article_ad\.php\? url jsonjq-response-body 'del(.["data"]["article_bottom"], .["data"]["recommend_ad"])'
^https:\/\/iphone\.myzaker\.com\/zaker\/follow_promote\.php\? url jsonjq-response-body '.data.list |= map(select(.type != "web"))'
^https:\/\/iphone\.myzaker\.com\/zaker\/car_tab\/index\.php\? url jsonjq-response-body '.data.gallery |= map(select(.type != "web"))'
^https:\/\/iphone\.myzaker\.com\/zaker\/block_top_ad\.php\? url reject-dict

hostname = iphone.myzaker.com, ggs.myzaker.com
