#!name = 智联招聘
#!desc = 移除开屏广告、弹窗、职位页面推广和各类横幅推广。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。（转自可莉 ZhiLianZhaoPin_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ZhiLianZhaoPin.png

^https:\/\/(ask|cgate)\.zhaopin\.com\/operation\/ad\/ url reject
^https:\/\/ask\.zhaopin\.com\/plat-zqa-server\/home\/\d\.\d\.\d\/getHomeContents\? url jsonjq-response-body 'del(.["data"]["templates"][0]["data"]["banner"])'
^https:\/\/cgate\.zhaopin\.com\/resumeapi\/resumeCheck\/positionDetailBottomTipCheck$ url reject-dict
^https:\/\/cgate\.zhaopin\.com\/bdp\/commercial\/queryLinkData$ url reject

hostname = ask.zhaopin.com, cgate.zhaopin.com
