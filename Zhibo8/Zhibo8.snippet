#!name = 直播吧
#!desc = 移除信息流广告、横幅广告、弹窗广告、皮肤配置、悬浮挂件、热门搜索，移除青少年模式，精简我的页面。（转自可莉 Zhibo8_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Zhibo8.png

^https:\/\/headline\.qiumibao\.com\/recommend\/list\? url jsonjq-response-body '.news|=map(select(.model=="news" or .model=="video"))'
^https:\/\/a\.qiumibao\.com\/found\/\? url jsonjq-response-body 'map(select(.is_game != true))'
^https:\/\/a\.qiumibao\.com\/ios\/config\/\? url jsonjq-response-body 'del(.["skin"], .["advert"], .["advert_config"], .["mall"], .["httpdns"], .["reward"], .["pgame"], .["corner_mark"], .["liveshop"], .["theme"], .["pop"], .["live_activity_push"])'
^https:\/\/a\.qiumibao\.com\/ios\/config\/\? url jsonjq-response-body '.all_sections.match_sections.labels |= (if . then (.blacks_disable |= if . then map(select(. != "游戏")) else . end) | (.show |= if . then map(select(. != "游戏")) else . end) else . end)'
^https:\/\/rn\.qiumibao\.com\/news\/relation\.php$ url reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/notice$ url reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/pop$ url reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/ep\/pop$ url reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/c\/banner$ url reject-dict
^https:\/\/guess\.qiumibao\.com\/api\/n\/rcd$ url jsonjq-response-body 'del(.["data"]["banner"])'
^https:\/\/pre-match\.qiumibao\.com\/pre_match_data\/v\d\/\d+-\d+-\d+\/\d+_fund\.htm\? url jsonjq-response-body 'del(.data[] | select(.type == "guide"))'
^https:\/\/guess\.qiumibao\.com\/api\/c\/menu$ url jsonjq-response-body 'del(.["data"]["banner"])'
^https:\/\/s\.qiumibao\.com\/m\/ios\/json\/zhibo\/zuqiu\/\d+\/match\d+vl\.htm\? url jsonjq-response-body 'del(.["ep_v2"], .["ep_live"])'
^https:\/\/search\.qiumibao\.com\/hot\/word_list$ url reject-dict

hostname = headline.qiumibao.com, a.qiumibao.com, rn.qiumibao.com, guess.qiumibao.com, pre-match.qiumibao.com, s.qiumibao.com, search.qiumibao.com
