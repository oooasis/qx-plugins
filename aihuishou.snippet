#!name = 爱回收
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 68 行，[A] 段；追加 lab:AiHuiShou.lpx（2026-10-02 12:00）的 4 条规则
#!author = ddgksf2013[https://github.com/ddgksf2013]

^https?:\/\/gw.aihuishou.com\/app-portal\/home\/getadvertisement url reject-200

# ↓ 来自 lab:AiHuiShou.lpx「爱回收」
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/dubai-gateway\/home\/config-renew-v3 url jsonjq-response-body '.data.promotionBannerConfigs=[] | .data.homeSecondFloorBanner=[] | .data.yanxuanSlogan=null | .data.recycleSlogan=null'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/products\/home\/config url jsonjq-response-body '.data.adBannerList=null | .data.categoryAdBannerList=[] | .data.adBannerImgList=[]'
^https:\/\/(?:dubai-app|dubai)\.aihuishou\.com\/ahs-yanxuan-service\/channel\/banner url jsonjq-response-body '.data.flowBannerList=[]'
^https:\/\/bi-log\.aihuishou\.com\/trace\/log\/ahs url reject-dict

hostname = gw.aihuishou.com, dubai-app.aihuishou.com, dubai.aihuishou.com, bi-log.aihuishou.com
