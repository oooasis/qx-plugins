#!name = 百度地图去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 87 行，[B] 段；追加 kelee:BaiduMap_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c]

^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads url script-response-body https://raw.githubusercontent.com/app2smile/rules/master/js/baidumap.js

# ↓ 来自 kelee:BaiduMap_remove_ads.lpx「百度地图去广告」
^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query) url reject-dict
^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\? url reject-dict

hostname = newclient.map.baidu.com, afd.baidu.com, ecom.map.baidu.com
