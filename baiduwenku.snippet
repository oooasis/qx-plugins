#!name = 百度文库去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 94 行，[B] 段；追加 kelee:BaiduWenku_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/appwk\.baidu\.com\/xpage\/interface\/wknaad url reject-200

# ↓ 来自 kelee:BaiduWenku_remove_ads.lpx「百度文库去广告」
^https:\/\/appwk\.baidu\.com\/appapi\/index\/home\? url jsonjq-response-body 'del(.["data"]["bannerInfo"], .["data"]["bannerList"], .["data"]["bannerListV2"])'
^https:\/\/appwk\.baidu\.com\/activity\/interface\/wkapppopup\? url reject-dict

hostname = appwk.baidu.com
