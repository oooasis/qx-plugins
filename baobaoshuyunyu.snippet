#!name = 宝宝树孕育去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 114 行，[B] 段；追加 kelee:BabyTree_remove_ads.lpx（2026-10-02 13:57:49）的 4 条规则
#!author = ddgksf2013, RuCu6[https://github.com/RuCu6]

^http:\/\/.*babytree\.com/(plough\.do|go_search\/api\/mobile_search_new\/get_multi_search_default_keywords) url reject-200
^http:\/\/m\.meitun\.com\/newapi\/router\/topic\/hometptf\/feedRecommend url reject-200

# ↓ 来自 kelee:BabyTree_remove_ads.lpx「宝宝树孕育去广告」
^http:\/\/go\.babytree\.com\/go_pregnancy\/api\/(index_activity\/get_app_index_activity|sign\/sign_h_5)\? url reject-dict
^http:\/\/api\.babytree\.com\/bafconfigcenter_intf\/config\/get\? url script-response-body https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js
^http:\/\/go\.babytree\.com\/go_pregnancy\/api\/(app_index\/get_app_tab|cms_column\/get_column_list|feeds\/get_index_feeds_list|user\/get_user_info)\? url script-response-body https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js
^http:\/\/go\.babytree\.com\/go_search\/api\/mobile_search_new\/search_index url script-response-body https://kelee.one/Resource/JavaScript/BabyTree/BabyTree_remove_ads.js

hostname = api.babytree.com, go.babytree.com
