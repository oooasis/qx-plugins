#!name = 贝壳找房去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 104 行，[B] 段；追加 kelee:Beike_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/apps\.api\.ke\.com\/config\/config\/(bootpage|getactivityconfig) url reject-200

# ↓ 来自 kelee:Beike_remove_ads.lpx「贝壳找房去广告」
^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/initData\/mini\? url jsonjq-response-body 'del(.["data"]["bootpage"], .["data"]["bottom_bar_activity"])'
^https:\/\/apps\.api\.ke\.com\/platform\/shellapp\/homepage\/feed\? url jsonjq-response-body '.data.list |= map(select(.cardType == "houseContainer" or .cardType == "houseV2" or .cardType == "houseV3" or .cardType == "rentHouseDiscount" or .cardType == "decorationCase"))'

hostname = apps.api.ke.com
