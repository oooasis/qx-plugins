#!author = ddgksf2013, RuCu6[https://github.com/RuCu6]

^https?:\/\/gg\.caixin\.com\/s\?z=caixin&op=1&c=3362 url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/caixinads.js
