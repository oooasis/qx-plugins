#!name = 学习通去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 131 行，[C] 段；替换为 kelee:ChaoXingStudy_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]


# ↓ 来自 kelee:ChaoXingStudy_remove_ads.lpx「学习通去广告」
^https:\/\/learn\.chaoxing\.com\/apis\/service\/appConfig\? url jsonjq-response-body 'del(.["data"]["ad"])'
^https:\/\/home-yd\.chaoxing\.com\/apis\/data\/getAdsRecommend\? url reject-dict
^https:\/\/home-yd\.chaoxing\.com\/apis\/banner\/getConfigInfoForXsqy\? url reject-dict

hostname = learn.chaoxing.com, home-yd.chaoxing.com
