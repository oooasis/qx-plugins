#!name = 叮咚买菜去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 206 行，[D] 段；替换为 kelee:DingdongMaicai_remove_ads.lpx（2026-10-02 13:57:49）的 10 条规则
#!author = ddgksf2013, zirawell[https://github.com/zirawell], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], wish


# ↓ 来自 kelee:DingdongMaicai_remove_ads.lpx「叮咚买菜去广告」
host, trackercollect.ddxq.mobi, reject
host, ddfs-public.ddimg.mobi, reject
host, rttrack.ddxq.mobi, reject
^https?:\/\/maicai\.api\.ddxq\.mobi\/advert\/ url reject
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/getHomeAdPop url reject
^https:\/\/maicai\.api\.ddxq\.mobi\/vip\/getVipAd\/\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/marketingNotice\? url reject-dict
^https:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/categoriesNewDetail\? url jsonjq-response-body 'del(.["data"]["ad_info"])'
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/newDetails\? url jsonjq-response-body 'del(.["data"]["top_advert_data"], .["data"]["suspension"])'
^https?:\/\/maicai\.api\.ddxq\.mobi\/homeApi\/homeFlowDetail url jsonjq-response-body 'walk(if type == "object" and has("list") then .list |= map(if type == "object" and has("multi_advertise_data_list") then del(.multi_advertise_data_list) else . end) else . end)'

hostname = maicai.api.ddxq.mobi
