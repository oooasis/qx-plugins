#!name = 斗鱼去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 175 行，[D] 段；追加 kelee:Douyu_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/rtbapi\.douyucdn\.cn\/japi\/sign\/app\/getinfo url reject-200

# ↓ 来自 kelee:Douyu_remove_ads.lpx「斗鱼去广告」
^https:\/\/apiv2\.douyucdn\.cn\/japi\/entrance\/roomRes\/nc\/m\/list url jsonjq-response-body 'del(.["data"]["pendant_a"], .["data"]["entrance_d"])'
^https:\/\/venus\.douyucdn\.cn\/venus\/config\/static\/update.+keyCodeSet=flow_config url jsonjq-response-body '.["greatGodGameSitterSwitch"] = 0 | .["followMoreAnchorEntrance"] = 0 | .["sdklivebanner"] = 0 | .["homeActFloatSwitch"] = 0 | .["bringGoodsSwitch"] = 0 | .["qqGameSwitch"] = 0'
^https:\/\/apiv2\.douyucdn\.cn\/mgapi\/livenc\/home\/getRecV3 url script-response-body https://kelee.one/Resource/JavaScript/Douyu/Douyu_remove_ads.js

hostname = rtbapi.douyucdn.cn, apiv2.douyucdn.cn, venus.douyucdn.cn
