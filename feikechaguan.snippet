#!name = 飞客去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 242 行，[F] 段；追加 kelee:FlyerTea_remove_ads.lpx（2026-10-02 13:57:49）的 2 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/.*flyert.*\/api\/mobile\/index\.php\?module=advis url reject-200
^https?:\/\/.*flyert.*\/source\/plugin\/mobile\/mobile\.php\?module=advis url reject-200
^https?:\/\/.*flyert.*\/api\/mobile\/index\.php\?version=\d&mobile=yes&module=basicdata&type=forumlist url response-body adv response-body ddgksf2013
^https?:\/\/.*flyert.*\/source\/plugin\/mobile\/mobile\.php\?module=threadpost&.+?&page=1 url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/fly.js

# ↓ 来自 kelee:FlyerTea_remove_ads.lpx「飞客去广告」
^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?version=5 url script-response-body https://kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js
^https:\/\/www\.flyert\.com\.cn\/api\/mobile\/index\.php\?module=plugin&id=k_misign:sign url script-response-body https://kelee.one/Resource/JavaScript/FlyerTea/FlyerTea_remove_ads.js

hostname = *.flyert.*, www.flyert.com, www.flyert.com.cn
