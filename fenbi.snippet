#!name = 粉笔去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 253 行，[F] 段；追加 kelee:FenBi_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/.*fenbi\.com\/(activity\/app\/launcher|app\/iphone\/nxs\/popup) url reject-200

# ↓ 来自 kelee:FenBi_remove_ads.lpx「粉笔去广告」
^https:\/\/keapi\.fenbi\.com\/app\/(iphone|ipad)\/position_resource\/get_banners\? url reject-dict
^https:\/\/keapi\.fenbi\.com\/app\/(iphone|ipad)\/position_resource\/get_home_banners\?.*position_resource_type=2 url reject-dict
^https:\/\/hera-webapp\.fenbi\.com\/(iphone|ipad)\/recommend\/info\? url jsonjq-response-body 'del(.["data"]["rollingBanner"])'

hostname = *.fenbi.com, keapi.fenbi.com, hera-webapp.fenbi.com
