#!name = 华住会去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 283 行，[H] 段；追加 kelee:HantingHotels_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/appapi\.huazhu\.com:\d{4}\/client\/app\/getAppStartPage\/ url reject-200

# ↓ 来自 kelee:HantingHotels_remove_ads.lpx「华住会去广告」
^https:\/\/hweb-manager\.huazhu\.com\/notice\/getAppPopupNotifyAlert$ url reject-dict
^https:\/\/hweb-hotel\.huazhu\.com\/home\/getHomeLoinBanner$ url reject-dict
^https:\/\/hweb-manager\.huazhu\.com\/hotels\/ad\/getHotelListNoticeMerge$ url reject-dict

hostname = appapi.huazhu.com, hweb-manager.huazhu.com, hweb-hotel.huazhu.com
