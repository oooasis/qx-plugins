#!name = 虎嗅去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 297 行，[H] 段；追加 kelee:Huxiu_remove_ads.lpx（2026-10-02 13:57:49）的 3 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https:\/\/api-ad-product\.huxiu\.com\/Api\/Product\/SDK\/Advert\/Query\/queryAdvertListInfo url reject-200

# ↓ 来自 kelee:Huxiu_remove_ads.lpx「虎嗅去广告」
host, api-ad-product.huxiu.com, reject
^https:\/\/api-ms-config\.huxiu\.com\/v1\/adConfig$ url reject-dict
^https:\/\/api-ms-feed\.huxiu\.com\/v1\/media\/recommend$ url jsonjq-response-body 'del(.["data"]["live"])'

hostname = api-ad-product.huxiu.com, api-ms-config.huxiu.com, api-ms-feed.huxiu.com
