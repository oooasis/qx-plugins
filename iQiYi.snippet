#!name = 爱奇艺去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 338 行，[I] 段；追加 kelee:iQiYi_Video_remove_ads.lpx（2026-10-02 13:57:49）的 7 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/.*cupid\.iqiyi\.com\/mixer\? url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/iqiyi_open_ads.js

# ↓ 来自 kelee:iQiYi_Video_remove_ads.lpx「爱奇艺去广告」
^https:\/\/cards\.iqiyi\.com\/views_home\/3\.0\/qy_home\? url jsonjq-response-body 'del(.cards[] | select(.alias_name == "focus" or .alias_name == "ad_mobile_flow" or .alias_name == "ad_trueview"))'
^https:\/\/cards\.iqiyi\.com\/views_category\/3\.0\/category_home\? url jsonjq-response-body 'del(.base.statistics | select(.ad_str)) | del(.cards[] | select(.alias_name == "entrence_focus" or .alias_name == "ad_trueview"))'
^https:\/\/cards\.iqiyi\.com\/waterfall(-plt)?\/3\.0\/feed\? url jsonjq-response-body 'del(.base.statistics | select(.ad_str)) | del(.. | select(.block_class?))'
^https:\/\/cards\.iqiyi\.com\/views_search\/3\.0\/hot_query_search\? url jsonjq-response-body '.cards |= map(select(.alias_name as $name | $name != "ad_trueview" and $name != "ad_mobile_flow" and $name != "search_mid_text_ad")) | if .base.statistics.ad_str? then del(.base.statistics) else . end'
^https?:\/\/iface2\.iqiyi\.com\/views_pop\/3\.0\/pop_control\? url reject-dict
^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? url jsonjq-response-body 'del(.["content"]["resource"]["cast_device_ad"])'
^https?:\/\/iface2\.iqiyi\.com\/fusion\/3\.0\/common_switch\? url jsonjq-response-body '.["content"]["switchs"]["app_ad"]["app_ad_enable"] = 0 | .["content"]["switchs"]["app_ad"]["app_ad_duration"] = 0 | .["content"]["switchs"]["ios_tech"]["kPreadAdHintSwitch"] = 0 | .["content"]["switchs"]["ios_tech"]["ad_download"] = 0 | .["content"]["switchs"]["m_qiyi_ios_tech"]["KFocusAdVideoPlayTimesIn4G"] = 0'

hostname = *cupid.iqiyi.com, *.iqiyi.com
