#!name = 凤凰新闻
#!desc = 移除皮肤、开屏广告、信息流广告、文末广告、视频流广告、评论区广告，移除信息流订阅号文章、文末推荐阅读，精简我的页面。（转自可莉 ifengNews_remove_ads.lpx，2026-10-02 13:57:49）
#!author = 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/ifengNews.png

^https:\/\/nine\.ifeng\.com\/adPreload\? url reject-dict
^https:\/\/nine\.ifeng\.com\/startUpAdPrestrainList\? url reject-dict
^https:\/\/nine\.ifeng\.com\/startUpAddAd\? url reject-dict
^https:\/\/config\.nine\.ifeng\.com\/news\/cow\? url jsonjq-response-body '.bottomNav|=map(select(.NavId=="bottomNavNews" or .NavId=="bottomNavMine"))'
^https:\/\/config\.nine\.ifeng\.com\/news\/cow\? url jsonjq-response-body 'del(.["zip_url"])'
^https:\/\/config\.nine\.ifeng\.com\/news\/h5prepublish\? url reject
^https:\/\/nine\.ifeng\.com\/searchhotwordsrollv\d\? url reject-dict
^https:\/\/nine\.ifeng\.com\/searchvideohotwordsroll\? url reject-dict
^https:\/\/nine\.ifeng\.com\/searchHotwordsReact\? url reject-dict
^https:\/\/user\.iclient\.ifeng\.com\/active_task\/channel\? url reject-dict
^https:\/\/config\.nine\.ifeng\.com\/news\/channel\? url jsonjq-response-body '.defaultChannel |= map(select(.id == "commenterch" or .id == "sy" or .id == "vipchannel" or .id == "rank_hot_merge" or .id == "rtnews" or .id == "sp" or .id == "mil" or .id == "finance" or .id == "history" or .id == "momentsnew" or .id == "taihai" or .id == "focusnews" or .id == "rcmd" or .id == "tw" or .id == "HK" or .id == "dawanqu1"))'
^https:\/\/config\.nine\.ifeng\.com\/news\/channel\? url jsonjq-response-body 'del(.["more"], .["youngChannel"])'
^https:\/\/nine\.ifeng\.com\/headline\? url jsonjq-response-body 'walk(if type == "object" and has("item") and (.item | type == "array") then .item |= map(select(.type == "phvideo" or .type == "doc" or .type == "phreclist")) else . end)'
^https:\/\/nine\.ifeng\.com\/getNewsDocs\? url jsonjq-response-body 'del(.["body"]["showAdvert"], .["body"]["adData"])'
^https:\/\/nine\.ifeng\.com\/newRelatedDocs\? url reject-dict
^https:\/\/nine\.ifeng\.com\/getdocbackinfo\? url reject-dict
^https:\/\/user\.iclient\.ifeng\.com\/event_protal\/list_lite\? url reject-dict
^https:\/\/nine\.ifeng\.com\/phoenixTvChannel\? url jsonjq-response-body 'map(if has("item") then .item|=map(select(.type=="columnfastmessagescroll" or .type=="phvideo" or .type=="videoseriesrecommendmarquee" or .type=="short")) else . end)'
^https:\/\/nine\.ifeng\.com\/adVideoImmersionWindow\? url reject-dict
^https:\/\/nine\.ifeng\.com\/videoimmersionlistv\d\? url jsonjq-response-body 'map(if has("item") then .item|=map(select(.type=="miniVideo" or .type=="phvideo")) else . end)'
^https:\/\/nine\.ifeng\.com\/shortList\? url jsonjq-response-body 'map(.item|=map(select(.type=="short")))'
^https:\/\/comment\.ifeng\.com\/v\d\/get\/commentlist\? url jsonjq-response-body 'del(.comments[] | select(.type == "advert"))'

hostname = nine.ifeng.com, config.nine.ifeng.com, user.iclient.ifeng.com, comment.ifeng.com
