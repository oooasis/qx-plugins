#!name = 快对去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 436 行，[K] 段；追加 kelee:KuaiDuiZuoYe_remove_ads.lpx（2026-10-02 13:57:49）的 5 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/adx\.zuoyebang\.com\/adxserver\/ url reject-200

# ↓ 来自 kelee:KuaiDuiZuoYe_remove_ads.lpx「快对去广告」
host, adx.zuoyebang.com, reject
^https:\/\/www\.kuaiduizuoye\.com\/init\/ad\/ url reject-dict
^https:\/\/www\.kuaiduizuoye\.com\/kdapi\/conf\/appbannersv3$ url reject-dict
^https:\/\/www\.kuaiduizuoye\.com\/kdapi\/conf\/initbanner$ url reject-dict
^https:\/\/www\.kuaiduizuoye\.com\/codesearch\/aid\/home$ url jsonjq-response-body 'del(.["data"]["homeBannerList"])'

hostname = adx.zuoyebang.com, www.kuaiduizuoye.com
