#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/api.kkmh.com\/v\d\/(ad|advertisement)\/ url reject-200

# ↓ 来自 kelee:KuaiKanComic_remove_ads.lpx「快看漫画去广告」
host, ad.v3mh.com, reject
^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/ad\/ url reject-dict
^https:\/\/(cdn-)?pay\.kkmh\.com\/v\d\/kb\/comic_page_banner\/detail url reject-dict
^https:\/\/(cdn-)?api\.kkmh\.com\/v\d\/business\/fake_push\/info url reject-dict

hostname = api.kkmh.com, cdn-api.kkmh.com, pay.kkmh.com, cdn-pay.kkmh.com
