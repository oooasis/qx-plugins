#!name = 朴朴超市去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 599 行，[P] 段；追加 kelee:PuPuMall_remove_ads.lpx（2026-10-02 13:57:49）的 5 条规则
#!author = ddgksf2013, kelv1n1n[https://github.com/kelv1n1n], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v url response-body launch_time_close":\d+ response-body launch_time_close":1660716799999
^https?:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v\d\?position url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/master/pupumarket.js

# ↓ 来自 kelee:PuPuMall_remove_ads.lpx「朴朴超市去广告」
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7\?position_types=100 url reject
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/v7 url script-response-body https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/banner\/search_component_banner url script-response-body https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/app_resource\/resource_preload\/list_h5_resource url script-response-body https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js
^https:\/\/j1\.pupuapi\.com\/client\/marketing\/advertisement\/v1 url script-response-body https://kelee.one/Resource/JavaScript/PuPuMall/PuPuMall_remove_ads.js

hostname = j1.pupuapi.com
