#!name = 什么值得买去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 707 行，[S] 段；追加 kelee:smzdm_remove_ads.lpx（2026-10-02 13:57:49）的 7 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/.*zdmimg\.com\/cpm\/api\/v\d\/advert_distribution\/get_all_advertise url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/smzdm_json.js

# ↓ 来自 kelee:smzdm_remove_ads.lpx「什么值得买去广告」
host, adx-api.zdmimg.com, reject
^https:\/\/app-api\.smzdm\.com\/util\/loading\? url reject-dict
^https:\/\/app-api\.smzdm\.com\/util\/update$ url jsonjq-response-body 'def r: if type=="object" then if has("ad_campaign_name") and (.ad_campaign_name|type=="string") and (.ad_campaign_name|test("\\S")) then empty else . end elif type=="array" then map(r) else . end; .data.operation_float |= map(map(r))'
^https:\/\/homepage-api\.smzdm\.com\/v3\/home\? url jsonjq-response-body '.data.component |= map( if (.zz_content | type) == "array" then .zz_content |= map( select( ( (.ad_campaign_id? | type == "string" and length > 0) // false ) or ( (.tag? | type == "string" and length > 0) // false ) or ( (.model_type? == "ads" and (type == "string")) // false ) | not ) ) else . end ) | .data.component |= map( select(.zz_type == "circular_banner" or .zz_type == "filter" or .zz_type == "list") ) | .data.component |= map( .zz_content |= ( if type == "array" then map( if type == "object" and (.article_channel_type // "") == "questionnaire" then empty else . end ) else . end ) ) | del(.data.theme) | .data.component |= map( if .zz_content | type == "object" then .zz_content |= del(.circular_banner_option) else . end )'
^https:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul\? url jsonjq-response-body 'del(.["data"]["banner"])'
^https:\/\/s-api\.smzdm\.com\/sou\/list_v10\? url jsonjq-response-body '.data.rows |= map(select(.model_type != "ads")) | .data.top_aladdin |= map(select(has("ad") | not))'
^https:\/\/post\.m\.smzdm\.com\/ajax_app\/ajax_get_footer_list\? url jsonjq-response-body 'del(.["data"]["tuiguang_ad"], .["data"]["activity_banner"])'

hostname = *.zdmimg.com, app-api.smzdm.com, homepage-api.smzdm.com, haojia.m.smzdm.com, s-api.smzdm.com, post.m.smzdm.com
