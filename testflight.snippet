#!name = TestFlight去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 723 行，[T] 段
#!author = ddgksf2013

^https?:\/\/testflight\.apple\.com\/v2\/accounts\/.*\/apps\/\d*/builds/\d*/install url request-body storefrontId" : ".*" request-body storefrontId" : "143441-1,29"

# 注：以下规则的主机不在上游 hostname 里（HTTPS 下不生效，上游原样如此）：
#   ^https?:\/\/testflight\.apple\.com\/v2\/accounts\/.*\/apps\/\d*/builds/\d*/install url request-body storefrontId" : ".*" request-body storefrontId" : "143441-1,29"
