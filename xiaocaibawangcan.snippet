#!name = 小蚕霸王餐去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 872 行，[X] 段；追加 kelee:XiaoCan_remove_ads.lpx（2026-10-02 13:57:49）的 1 条规则
#!author = ddgksf2013, Sliverkiss[https://github.com/Sliverkiss], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/.*1rtb\.net\/sdk\/req_ad\? url reject-200

# ↓ 来自 kelee:XiaoCan_remove_ads.lpx「小蚕霸王餐去广告」
^https:\/\/gw\.xiaocantech\.com\/rpc url request-header (\r\n)methodname:.+(\r\n) request-header $1methodname: /.*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg)/$2

hostname = *.1rtb.net, gw.xiaocantech.com
