#!name = 小蚕惠生活去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 901 行，[X] 段；追加 lab:XiaoCan.lpx（2026-10-02 12:00）的 2 条规则
#!author = ddgksf2013, Sliverkiss[https://github.com/Sliverkiss], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https:\/\/gw\.xiaocantech\.com\/rpc url response-body "vip_pop_up":0 response-body "vip_pop_up":2

# ↓ 来自 lab:XiaoCan.lpx「小蚕惠生活」
^https:\/\/gw\.xiaocantech\.com\/rpc url request-header (\r\n)methodname:.+(\r\n) request-header $1methodname: /.*(GetBannerList|IsShowOrderAwardPopup|UserLifeShopList|BrandBannerList|GetPromotionGlobalCfg)/$2
^https:\/\/sdk\.1rtb\.net\/sdk\/req_ad\? url reject-dict

hostname = gw.xiaocantech.com, sdk.1rtb.net
