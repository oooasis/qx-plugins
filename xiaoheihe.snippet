#!name = 小黑盒去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 892 行，[X] 段；追加 kelee:XiaoHeiHe_remove_ads.lpx（2026-10-02 13:57:49）的 1 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/api\.xiaoheihe\.cn\/.*get_ads_info url reject-200

# ↓ 来自 kelee:XiaoHeiHe_remove_ads.lpx「小黑盒去广告」
^https:\/\/api\.xiaoheihe\.cn\/bbs\/app\/feeds\/news url jsonjq-response-body '.result.links |= map(if .content_type == 27 then del(.title, .ad_pm, .img_gif, .idea_id, .ad_report, .label, .source, .intranet_only, .ad_cm, .content_type, .PROTOCOL, .img, .ad_ratio) else . end)'

hostname = api.xiaoheihe.cn
