#!name = 易校园去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 959 行，[Y] 段；追加 kelee:YiSchool_remove_ads.lpx（2026-10-02 13:57:49）的 1 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/compus\.xiaofubao\.com\/compus\/advertising url reject-200

# ↓ 来自 kelee:YiSchool_remove_ads.lpx「易校园去广告」
^https:\/\/compus\.xiaofubao\.com\/compus\/user\/getUserExt$ url jsonjq-response-body 'del(.["data"]["adPopSwitch"], .["data"]["adSplashSwitch"])'

hostname = compus.xiaofubao.com
