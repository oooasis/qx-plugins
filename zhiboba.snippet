#!name = 直播吧去开屏
#!desc = 拆自 ddgksf2013 StartUpAds.conf（2026-08-29）第 994 行，[Z] 段；追加 kelee:Zhibo8_remove_ads.lpx（2026-10-02 13:57:49）的 1 条规则
#!author = ddgksf2013, 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]

^https?:\/\/a\.qiumibao\.com\/activities\/config\.php$ url reject-200
^https?:\/\/a\.qiumibao\.com\/ios\/config\/\?version_code= url reject-200

# ↓ 来自 kelee:Zhibo8_remove_ads.lpx「直播吧去广告」
^https:\/\/headline\.qiumibao\.com\/recommend\/list\? url jsonjq-response-body '.news|=map(select(.model=="news" or .model=="video"))'

hostname = a.qiumibao.com, headline.qiumibao.com
